{
    "configurations": [
        {
            "name": "Mac",
            "includePath": [
                "${workspaceFolder}/../ccore/source/**",
                "${workspaceFolder}/../cunittest/source/**",
                "${workspaceFolder}/../rcore/source/**",
                "${workspaceFolder}/../rwifi/source/**",
                "${workspaceFolder}/../rlcd/source/**",
                "${workspaceFolder}/../rsensors/source/**"
            ],
            "defines": [
                "TARGET_DEBUG"
            ],
            "compilerPath": "/usr/bin/clang",
            "cStandard": "c17",
            "cppStandard": "c++14",
            "intelliSenseMode": "macos-clang-arm64",
            "mergeConfigurations": false,
            "recursiveIncludes": {},
            "browse": {
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}